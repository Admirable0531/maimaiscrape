# ---- Discord bot ----
DISCORD_TOKEN=your_discord_bot_token
# Must have "Message Content Intent" enabled in the Discord Developer Portal
# (Bot -> Privileged Gateway Intents), or the bot will receive empty message
# content and never respond.

# ---- Slash command deployment (only needed for `node deploy-commands.js`) ----
CLIENT_ID=your_bot_application_id
GUILD_ID=your_test_server_id

# ---- Permissions ----
# Your Discord user ID. This account always has permission and is the only
# one who can grant/revoke access for others (see README for the commands).
# Get it via Discord: User Settings -> Advanced -> Developer Mode, then
# right-click your name -> Copy User ID.
OWNER_USER_ID=your_discord_user_id

# ---- Provider switch ----
# Primary provider is DeepSeek (deepseek-v4-flash); if it errors (missing
# key, network issue, empty response) agent.js automatically falls back to
# Gemini. Get a DeepSeek key at https://platform.deepseek.com/api_keys
# Set AI_PROVIDER_FALLBACK="" to disable the fallback instead of using Gemini.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash
AI_PROVIDER_FALLBACK=gemini

# Groq is also available (free tier, no card needed) — set AI_PROVIDER=groq
# or AI_PROVIDER_FALLBACK=groq to use it instead of/alongside the above.
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=llama-3.3-70b-versatile

# ---- Gemini ----
GEMINI_API_KEY=your_gemini_api_key
# Defaults to gemini-3.5-flash-lite if unset.
GEMINI_MODEL=gemini-3.5-flash-lite
# Hard cap on a single reply's length. Discord truncates at 2000 chars
# anyway, so anything beyond a couple thousand tokens is wasted spend.
GEMINI_MAX_OUTPUT_TOKENS=2048
# -1 = let Gemini decide how much to "think" per request (no ceiling), 0 =
# disable thinking entirely (cheapest, but tool-call accuracy may suffer).
# The default below is a fixed moderate budget: caps worst-case cost while
# leaving room for real reasoning. Unverified against a live key — tune
# this once you can see real usage.
GEMINI_THINKING_BUDGET=1024
# Starting tool-call budget per message (not a hard cap — see
# GEMINI_TOOL_BUDGET_EXTEND_STEP below, and src/ai/providers/geminiProvider.js).
GEMINI_MAX_TOOL_ITERATIONS=6
# Absolute ceiling even after the model asks for more budget mid-message.
GEMINI_MAX_TOOL_ITERATIONS_HARD=16
# How many extra tool calls one request_more_tool_calls grant adds.
GEMINI_TOOL_BUDGET_EXTEND_STEP=4

# ---- Web search (Tavily) ----
# https://tavily.com — used by the search_web tool.
TAVILY_API_KEY=your_tavily_api_key

# ---- maimai stats API ----
# Base URL of the existing Express API in this repo (server/express_server.js
# — run via `docker compose up api`, or `node server/express_server.js`).
# Used by get_friend_leaderboard / get_circle_rankings for this group's own
# tracked ratings and circle points. Default assumes both this bot and that
# API run on the same machine, with docker-compose's "api" service publishing
# port 3000 to the host (see docker-compose.yml) — change this only if the
# API runs on a different machine or port.
MAIMAI_API_URL=http://localhost:3000

# ---- maimai account browsing ----
# SEGA login for one tracked account, used to browse its own live
# maimaidx-eng.com/maimai-mobile/... pages (rating, play records,
# collection, friend list) via read_webpage — see src/web/maimaiAccountSession.js.
# Nothing on that site is viewable without a real login, so this is required
# for that capability specifically (everything else still works without it).
MAIMAI_LOGIN_SID=your_sega_id
MAIMAI_LOGIN_PASSWORD=your_sega_password
# Auto-closes the shared logged-in browser after this many ms of inactivity
# (same idea as PLAYWRIGHT_IDLE_TIMEOUT_MS below). Default 5 minutes.
MAIMAI_ACCOUNT_IDLE_TIMEOUT_MS=300000

# ---- Behavior (all optional, defaults shown) ----
# How many past messages (combined user + assistant) to keep per channel.
MAX_HISTORY_MESSAGES=4
# Minimum time between replies to the same user, in milliseconds.
REPLY_COOLDOWN_MS=3000
# How long to keep chat history (not memories -- those persist forever) in
# SQLite before it's auto-deleted. Keeps the database from growing forever,
# which matters more on a Pi's small SD card than on typical server storage.
CONVERSATION_RETENTION_DAYS=30

# read_webpage falls back to a headless browser (Playwright) when a static
# fetch returns almost no text, for JS-rendered pages. Requires the Chromium
# browser binary: run `npx playwright install chromium` once after
# `npm install` (~200-300MB download + disk). Set to false to skip the
# fallback entirely and never launch a browser -- read_webpage will just
# return whatever the static fetch got.
#
# Worth setting to false on a Raspberry Pi 4 or similar: a resident Chromium
# process is 200MB+ of RAM, and the sites this bot actually needs it for are
# already covered another way -- search_maimai_songs replaces it for
# arcade-songs.zetaraku.dev, and the other maimai wiki sources (RemyWiki,
# Moegirl) work fine over the plain static-fetch path.
ENABLE_PLAYWRIGHT_FALLBACK=true
# Auto-closes the Chromium process after this many ms of no read_webpage
# fallback activity, freeing its RAM; relaunches on the next JS-rendered
# page (measured ~100-200ms of extra process-startup overhead vs an
# already-warm browser -- per-page navigation dominates the total either
# way, so this is a small cost for real RAM savings). Set to 0 to keep it
# always warm instead. Irrelevant if the fallback is disabled above.
PLAYWRIGHT_IDLE_TIMEOUT_MS=300000
