# ---- maimai login used by the top-score scraper (server/update_user_data.js) ----
MAIMAI_USER=your_maimai_username
MAIMAI_PASS=your_maimai_password

# ---- Discord bot ----
DISCORD_TOKEN=your_discord_token
CLIENT_ID=your_bot_client_id
GUILD_ID=your_guild_id
DAILY_SCORE_CHANNEL_ID=1233678655717118022

# ---- MongoDB ----
MONGO_URI=mongodb://mongodb:27017/mydatabase
DB_NAME=mydatabase

# ---- maimai accounts used by the friend-list / circle-ranking scrapers ----
MAIMAI_ACCOUNT_RATING_FY=your_fy_sega_id
MAIMAI_ACCOUNT_RATING_MAIN=your_main_sega_id
MAIMAI_PASSWORD_RATING=your_sega_password

# ---- Discord webhooks ----
FRIEND_WEBHOOK_URL_FY=https://discord.com/api/webhooks/...
FRIEND_WEBHOOK_URL_TEST=https://discord.com/api/webhooks/...
CIRCLE_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ---- Daily automation (Discord bot owns the schedule) ----
# HH:MM in the container timezone (TZ=Asia/Kuala_Lumpur). Runs the whole chain:
# top scores -> friend ratings -> post score diff -> post friends leaderboard.
DAILY_PIPELINE_AT=22:45
# HH:MM for the once-daily circle ranking scrape (after maimai maintenance ends).
CIRCLE_RUN_AT=06:30
# Set to false to disable the bot's daily pipeline entirely (manual commands only).
DAILY_PIPELINE_ENABLED=true
# Base URL of the express api container, used to trigger the Puppeteer scrape.
EXPRESS_URL=http://api:3000
# Minutes to allow the top-score scrape to run before giving up.
SCRAPE_TIMEOUT_MINUTES=45

# The scraper container's own cron is disabled: the bot orchestrates the run so
# scraping and posting can't race each other. Set to true to re-enable it.
SCRAPER_CRON_ENABLED=false

# ---- Puppeteer / debugging ----
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# HEADLESS=false
# SCREENSHOT_DEBUG=1
