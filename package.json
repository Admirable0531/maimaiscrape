{
  "name": "maimaiscrape",
  "version": "1.0.0",
  "private": true,
  "description": "Maimai score scraper, Discord bot and API",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "bot": "node discord-bot/index.js",
    "api": "node server/express_server.js",
    "deploy-commands": "node discord-bot/deploy-commands.js",
    "scraper": "node server/update_user_data.js",
    "run-scraper": "node server/update_user_data.js",
    "friends": "node discord-bot/scripts/friends_webhook.js",
    "circle": "node discord-bot/scripts/circle_ranking_scraper.js",
    "daily-points": "node discord-bot/scripts/daily_points_tracker.js",
    "migrate": "node server/scripts/migrate-collections-to-friend-idx.js",
    "db-audit": "node server/scripts/db-audit.js",
    "lint": "eslint discord-bot/ server/ scripts/",
    "format": "prettier --write \"discord-bot/**/*.js\" \"server/**/*.js\" \"scripts/**/*.js\""
  },
  "dependencies": {
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "mongodb": "^6.5.0",
    "node-cron": "^3.0.3",
    "puppeteer": "^23.11.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6"
  }
}
