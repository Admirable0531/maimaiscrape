# Puppeteer-based user-data scraper (replaces Selenium scraper)
FROM node:18-bullseye

# Install Chromium and dependencies (same as Discord_Bot for Puppeteer)
RUN apt-get update && apt-get install -y \
  chromium \
  fonts-liberation \
  libappindicator3-1 \
  libasound2 \
  libatk-bridge2.0-0 \
  libatk1.0-0 \
  libcups2 \
  libdbus-1-3 \
  libgdk-pixbuf2.0-0 \
  libnspr4 \
  libnss3 \
  libxss1 \
  xdg-utils \
  --no-install-recommends && \
  apt-get clean && \
  rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1

WORKDIR /app

# Use bot's package.json for puppeteer, node-cron, dotenv
COPY Discord_Bot/package*.json ./
RUN npm install

COPY server/ ./server/

CMD ["node", "server/run-user-data-cron.js"]
