# Manual-run Puppeteer scraper image (see the `scraper` service in docker-compose.yml).
FROM node:18-bullseye

# Chromium and its runtime libraries (same set as Discord_Bot/Dockerfile)
RUN apt-get update && apt-get install -y \
  chromium \
  fonts-liberation \
  libappindicator3-1 \
  libasound2 \
  libatk-bridge2.0-0 \
  libatk1.0-0 \
  libcups2 \
  libdbus-1-3 \
  libgdk-pixbuf2.0-0 \
  libnspr4 \
  libnss3 \
  libxss1 \
  xdg-utils \
  --no-install-recommends && \
  apt-get clean && \
  rm -rf /var/lib/apt/lists/*

# Use system Chromium; Puppeteer's bundled build is x86-only and unusable on ARM.
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PUPPETEER_SKIP_DOWNLOAD=1
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1

WORKDIR /app

# Shares the bot's dependency set (puppeteer, mongodb, node-cron, dotenv)
COPY package*.json ./
RUN npm install --omit=dev

# Mirror the repository layout so relative requires resolve as they do locally.
COPY Discord_Bot/ ./Discord_Bot/
COPY server/ ./server/

CMD ["node", "server/run-user-data-cron.js"]
